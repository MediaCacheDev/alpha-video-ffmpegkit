{
  "name": "react-native-alpha-video-ffmpegkit",
  "version": "1.0.0",
  "description": "Transparent video for React Native: VP9 WebM with alpha on iOS and Android, decoded by FFmpegKit from plain Java and Swift, drawn with Metal / OpenGL ES or as bitmaps. Falls back to <video> on the web.",
  "main": "react-native/src/index.js",
  "types": "react-native/src/index.d.ts",
  "files": [
    "react-native",
    "ios",
    "android/src",
    "react-native.config.js",
    "react-native-alpha-video-ffmpegkit.podspec",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!ios/build",
    "!.DS_Store"
  ],
  "scripts": {
    "publish:android:local": "scripts/publish-android.sh local"
  },
  "codegenConfig": {
    "name": "RNFFmpegKitAlphaSpec",
    "type": "components",
    "jsSrcsDir": "react-native/src",
    "android": {
      "javaPackageName": "dev.mediacache.alphavideo.ffmpegkit.reactnative"
    },
    "ios": {
      "componentProvider": {
        "RNFFmpegKitAlphaGPUView": "RNFFmpegKitAlphaGPUViewComponentView",
        "RNFFmpegKitAlphaCPUView": "RNFFmpegKitAlphaCPUViewComponentView"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielkpl2/alpha-video-ffmpegkit"
  },
  "homepage": "https://github.com/danielkpl2/alpha-video-ffmpegkit#readme",
  "keywords": [
    "react-native",
    "alpha",
    "transparent-video",
    "transparency",
    "webm",
    "vp9",
    "video",
    "ffmpeg",
    "ffmpegkit",
    "ios",
    "android"
  ],
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  }
}
